{
  "name": "workspace",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "prestart": "npm run build",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts,js,json --exec \"node --expose-gc --loader ts-node/esm src/server/index.ts\"",
    "pack:win": "npm run build && pkg -t node20-win-x64 -o build/mono-grid.exe dist/server/index.js --assets public/**",
    "format": "prettier --write \"{src,public}/**/*.{ts,js,css,html}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnxnam/NamPortfolioManagement.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ntnxnam/NamPortfolioManagement/issues"
  },
  "homepage": "https://github.com/ntnxnam/NamPortfolioManagement#readme",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "morgan": "^1.10.1",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "stoppable": "^1.1.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.5.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^13.1.1",
    "pkg": "^5.8.1",
    "prettier": "^3.6.2",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
